{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "client",
      "framework": "vite"
    },
    "api": {
      "root": "server",
      "framework": "express"
    },
    "ai": {
      "root": "ai-service",
      "framework": "fastapi",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": { "service": "ai", "path": "/api/v1/$1" }
    },
    {
      "source": "/api/(.*)",
      "destination": { "service": "api", "path": "/api/$1" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}

